# Server-side environment for the Vercel serverless functions in /api.
# Set this in the Vercel dashboard (Project → Settings → Environment Variables)
# or via `vercel env add GEMINI_API_KEY`. It is NEVER bundled into the client
# (verified: the built bundle contains no key and no googleapis reference).
#
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The proxy also accepts GOOGLE_API_KEY if you prefer the vendor-named var:
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the Gemini model (defaults to gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest

# Client-side variables live in client/.env.example (VITE_SPACETIME_HOST/DB).
