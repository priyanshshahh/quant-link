# SpacetimeDB connection (client bundle — safe to expose)
# Local dev
VITE_SPACETIME_HOST=127.0.0.1:3001
VITE_SPACETIME_DB=quant-link

# Production (uncomment after `spacetime publish quant-link` to maincloud)
# VITE_SPACETIME_HOST=maincloud.spacetimedb.com
# VITE_SPACETIME_DB=quant-link

# NOTE: There is intentionally NO LLM key here. The Gemini key is server-side
# only (GEMINI_API_KEY in the Vercel environment — see /.env.example at the
# repo root). Never add a VITE_-prefixed API key: Vite inlines those into the
# public JavaScript bundle.
